    "live": "npm run build && node walk/live.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "typescript": "^5.2.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@onlyworlds/sdk": "4.85.0"
  }
}
